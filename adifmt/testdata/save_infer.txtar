# Test that save infers the file type from the extension.

# ADI
stdin input.adi
exec adifmt save foo.adi
cmp foo.adi expected.adi
stderr 'Wrote 4 records to foo.adi'

# ADX
stdin input.adi
exec adifmt save foo.adx
cmp foo.adx expected.adx
stderr 'Wrote 4 records to foo.adx'

# CSV
stdin input.adi
exec adifmt save foo.csv
cmp foo.csv expected.csv
stderr 'Wrote 4 records to foo.csv'

# JSON
stdin input.adi
exec adifmt save foo.json
cmp foo.json expected.json
stderr 'Wrote 4 records to foo.json'

# TSV
stdin input.adi
exec adifmt save foo.tsv --tsv-escape-special
cmp foo.tsv expected.tsv
stderr 'Wrote 4 records to foo.tsv'

-- input.adi --
