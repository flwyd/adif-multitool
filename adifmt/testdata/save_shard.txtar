# Test that save shard flags effectively split into files.
# Note that distribution of records between shard files is documented as subject
# to change, so this test may update if the implementation changes.

# Maximum records per shard
stdin tenqsos.adi
exec adifmt save --shard-max-records 3 maxrecords.csv
cmp stderr expectedmaxstderr
cmp maxrecords+1-of-4.csv expectedmax1.csv
cmp maxrecords+2-of-4.csv expectedmax2.csv
cmp maxrecords+3-of-4.csv expectedmax3.csv
cmp maxrecords+4-of-4.csv expectedmax4.csv

# Explicit number of shards
stdin tenqsos.adi
exec adifmt save --shard-file-count 3 shardcount.csv
cmp stderr expectedcountstderr
cmp shardcount+1-of-3.csv expectedcount1.csv
cmp shardcount+2-of-3.csv expectedcount2.csv
cmp shardcount+3-of-3.csv expectedcount3.csv

# Incompatible shard desires
stdin tenqsos.adi
! exec adifmt save --shard-file-count 2 --shard-max-records 4 bad.csv
stderr 'could not split bad.csv: record count 10 with 2 shards would put more than 4 records in a file'

-- tenqsos.adi --
